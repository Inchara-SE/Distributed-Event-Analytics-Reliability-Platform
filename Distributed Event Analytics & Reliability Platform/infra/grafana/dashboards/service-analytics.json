{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Service Traffic & Rate Metrics (UTC Fixed 1-Minute Windows)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "req/sec", "drawStyle": "line", "fillOpacity": 15 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "Request Rate by Service (req/sec)",
      "description": "Calculated as canonical request_count / 60 over UTC minute windows",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service) (rate(pulsestream_events_published_total[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "events", "drawStyle": "bars", "fillOpacity": 30 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "Canonical Request Volume by Service",
      "description": "Total accepted canonical HTTP request completions per minute window",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service) (increase(pulsestream_events_published_total[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "Error Rates & Health Disaggregation",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "custom": { "axisCenteredZero": false, "axisLabel": "Ratio", "drawStyle": "line" },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "5xx Server Error Rate (HTTP 500-599)",
      "description": "server_error_count / request_count (5xx status codes only; 4xx client errors excluded)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service) (rate(pulsestream_events_status_total{status_group=\"5xx\"}[1m])) / sum by (service) (rate(pulsestream_events_published_total[1m]))",
          "legendFormat": "{{service}} 5xx Rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "Count", "drawStyle": "line" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "4xx Client Error Count (HTTP 400-499)",
      "description": "Disaggregated from server errors to prevent false alerting on bad client requests",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service) (increase(pulsestream_events_status_total{status_group=\"4xx\"}[1m]))",
          "legendFormat": "{{service}} 4xx Count",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 7,
      "title": "Latency Percentiles (Approximate t-digest)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "Duration (ms)", "drawStyle": "line" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "Request Duration Percentiles (p50, p95, p99 ms) - Approximate t-digest",
      "description": "Approximate quantile calculated via ClickHouse t-digest algorithms; labelled as approximate per TAD section 6.5",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, service) (rate(pulsestream_request_duration_ms_bucket[1m])))",
          "legendFormat": "{{service}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(pulsestream_request_duration_ms_bucket[1m])))",
          "legendFormat": "{{service}} p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(pulsestream_request_duration_ms_bucket[1m])))",
          "legendFormat": "{{service}} p99",
          "refId": "C"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["pulsestream", "analytics", "services"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "utc",
  "title": "PulseStream - Service Analytics"
}
